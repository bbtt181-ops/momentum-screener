# Copy this file to ".env" (same folder as daily_scan.py) and fill in real values.
# ".env" is git-ignored -- it never gets committed or uploaded to GitHub.
#
# Uses the same Gmail App Password as the dashboard's Streamlit secrets --
# see README.md "Email alerts" for how to create one.

GMAIL_SENDER_ADDRESS=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
ALERT_RECIPIENT_ADDRESS=where-alerts-should-go@example.com
